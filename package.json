{
  "name": "meoi-language-workspace",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "clean": "node scripts/clean-generated.mjs",
    "build": "npm run clean && tsc -b && npm run build:web && npm run build:extension",
    "build:web": "vite build",
    "build:extension": "tsc -p tsconfig.extension.json && node scripts/build-extension.mjs",
    "package:extension": "npm run build:extension && powershell -NoProfile -Command \"Compress-Archive -Path 'dist-extension\\*' -DestinationPath 'meoi-extension-v4.zip' -Force\"",
    "test": "npm run test:web && npm run test:extension",
    "test:web": "vitest run --config vitest.config.ts",
    "test:extension": "vitest run --config vitest.extension.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.1",
    "jsdom": "^24.1.3",
    "playwright": "^1.60.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.0"
  }
}
