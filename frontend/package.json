{
  "name": "meoing-frontend",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "clean": "node scripts/clean-generated.mjs",
    "build": "npm run clean && tsc -b && npm run build:web && npm run build:extension",
    "build:web": "vite build",
    "build:extension": "tsc -p tsconfig.extension.json && node scripts/build-extension.mjs",
    "package:extension": "npm run build:extension && powershell -NoProfile -Command \"Compress-Archive -Path 'dist-extension\\*' -DestinationPath 'meoi-extension-v8.zip' -Force\"",
    "test": "npm run test:web && npm run test:extension",
    "test:web": "vitest run --config vitest.config.ts",
    "test:extension": "vitest run --config vitest.extension.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@atlaskit/drag-and-drop-indicator": "0.11.1",
    "@atlaskit/pragmatic-drag-and-drop": "1.7.7",
    "@excalidraw/excalidraw": "^0.18.1",
    "@floating-ui/react": "0.27.19",
    "@k1low/hanzi-writer-data-jp": "0.8.0",
    "@lexical/a11y": "0.49.0",
    "@lexical/clipboard": "0.49.0",
    "@lexical/code": "0.49.0",
    "@lexical/code-core": "0.49.0",
    "@lexical/code-prism": "0.49.0",
    "@lexical/code-shiki": "0.49.0",
    "@lexical/extension": "0.49.0",
    "@lexical/file": "0.49.0",
    "@lexical/hashtag": "0.49.0",
    "@lexical/history": "0.49.0",
    "@lexical/html": "0.49.0",
    "@lexical/link": "0.49.0",
    "@lexical/list": "0.49.0",
    "@lexical/mark": "0.49.0",
    "@lexical/markdown": "0.49.0",
    "@lexical/overflow": "0.49.0",
    "@lexical/plain-text": "0.49.0",
    "@lexical/react": "0.49.0",
    "@lexical/rich-text": "0.49.0",
    "@lexical/selection": "0.49.0",
    "@lexical/table": "0.49.0",
    "@lexical/text": "0.49.0",
    "@lexical/utils": "0.49.0",
    "@supabase/supabase-js": "^2.111.0",
    "date-fns": "4.1.0",
    "hanzi-writer": "3.7.3",
    "hanzi-writer-data": "2.0.1",
    "katex": "^0.18.1",
    "lexical": "0.49.0",
    "lodash-es": "4.18.1",
    "lucide-react": "^0.468.0",
    "prettier": "3.6.2",
    "react": "^18.3.1",
    "react-day-picker": "9.14.0",
    "react-dom": "^18.3.1",
    "yjs": "13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^24.1.3",
    "playwright": "^1.60.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.16"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1",
    "postcss": "8.5.25"
  }
}
