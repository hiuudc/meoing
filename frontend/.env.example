# For local browser development against a remote environment, point the API at
# Vite's same-origin proxy and set MEOI_DEV_API_PROXY_TARGET below. This keeps
# staging CORS restricted to the deployed staging origin.
VITE_MEOI_API_URL=http://127.0.0.1:5173/__meoing_api
MEOI_DEV_API_PROXY_TARGET=https://api-staging.example.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional in local development. Configure this in staging and production.
VITE_TURNSTILE_SITE_KEY=

# Extension production builds: comma-separated HTTPS origins, without paths.
MEOI_WEB_ORIGINS=https://staging.example.com,https://app.example.com
