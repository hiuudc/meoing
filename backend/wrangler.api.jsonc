{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meoing-api",
  "main": "src/api-worker.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "APP_ENV": "local",
    "CORS_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173",
    "SUPABASE_URL": "https://PROJECT_REF.supabase.co",
    "SUPABASE_JWT_AUDIENCE": "authenticated",
    "R2_ACCOUNT_ID": "REPLACE_WITH_ACCOUNT_ID",
    "R2_BUCKET_NAME": "meoing-files-local",
    "PRESIGNED_UPLOAD_TTL_SECONDS": "900",
    "PRESIGNED_DOWNLOAD_TTL_SECONDS": "300"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "meoing-files-local"
    }
  ],
  "ratelimits": [
    {
      "name": "READ_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "WRITE_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "PROGRESS_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  // Replace every placeholder before the first staging/production deployment.
  // Bindings and vars are deliberately repeated because Wrangler environments do not inherit them.
  "env": {
    "staging": {
      "vars": {
        "APP_ENV": "staging",
        "CORS_ORIGINS": "https://staging.meoing.app",
        "SUPABASE_URL": "https://STAGING_PROJECT_REF.supabase.co",
        "SUPABASE_JWT_AUDIENCE": "authenticated",
        "R2_ACCOUNT_ID": "REPLACE_WITH_ACCOUNT_ID",
        "R2_BUCKET_NAME": "meoing-files-staging",
        "PRESIGNED_UPLOAD_TTL_SECONDS": "900",
        "PRESIGNED_DOWNLOAD_TTL_SECONDS": "300"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000000000000000000000000000"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "meoing-files-staging"
        }
      ],
      "ratelimits": [
        {
          "name": "READ_RATE_LIMIT",
          "namespace_id": "1101",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "WRITE_RATE_LIMIT",
          "namespace_id": "1102",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "PROGRESS_RATE_LIMIT",
          "namespace_id": "1103",
          "simple": { "limit": 120, "period": 60 }
        }
      ]
    },
    "production": {
      "vars": {
        "APP_ENV": "production",
        "CORS_ORIGINS": "https://meoing.app",
        "SUPABASE_URL": "https://PRODUCTION_PROJECT_REF.supabase.co",
        "SUPABASE_JWT_AUDIENCE": "authenticated",
        "R2_ACCOUNT_ID": "REPLACE_WITH_ACCOUNT_ID",
        "R2_BUCKET_NAME": "meoing-files-production",
        "PRESIGNED_UPLOAD_TTL_SECONDS": "900",
        "PRESIGNED_DOWNLOAD_TTL_SECONDS": "300"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000000000000000000000000000"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "meoing-files-production"
        }
      ],
      "ratelimits": [
        {
          "name": "READ_RATE_LIMIT",
          "namespace_id": "2101",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "WRITE_RATE_LIMIT",
          "namespace_id": "2102",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "PROGRESS_RATE_LIMIT",
          "namespace_id": "2103",
          "simple": { "limit": 120, "period": 60 }
        }
      ]
    }
  }
}
